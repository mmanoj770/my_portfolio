{
  "applet": "Bulb Off",
  "if_this": {
    "service": "Google Assistant",
    "trigger": "Activate scene",
    "scene_name": "Bulb Off",
    "spoken_phrase": "Hey Google, activate Bulb Off"
  },
  "then_that": {
    "service": "Webhooks",
    "action": "Make a web request",
